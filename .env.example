# Gemini API Anahtarı (Google AI Studio üzerinden alınır)
# Sunucu tarafında app/api/chat/route.ts tarafından process.env üzerinden okunur.
# Güvenlik için ASLA NEXT_PUBLIC_ öneki KULLANILMAMALIDIR!
GEMINI_API_KEY="your_gemini_api_key_here"

# Uygulama URL'i (Geliştirme veya Canlı ortam)
APP_URL="http://localhost:3000"

# Veritabanı Bağlantıları (PostgreSQL / Prisma)
POSTGRES_URL="postgres://user:password@host:5432/dbname?sslmode=require"
PRISMA_DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"
